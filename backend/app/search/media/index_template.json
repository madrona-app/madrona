{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "media_text_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "english_stemmer"
          ]
        },
        "filename_analyzer": {
          "type": "custom",
          "tokenizer": "filename_tokenizer",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "tag_analyzer": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": [
            "lowercase"
          ]
        }
      },
      "tokenizer": {
        "filename_tokenizer": {
          "type": "pattern",
          "pattern": "[\\s\\-_\\.]+",
          "lowercase": true
        }
      },
      "filter": {
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        },
        "autocomplete_filter": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "media_id": {
        "type": "keyword"
      },
      "organization_id": {
        "type": "keyword"
      },
      "filename": {
        "type": "text",
        "analyzer": "filename_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "title": {
        "type": "text",
        "analyzer": "media_text_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "description": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "alt_text": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "media_type": {
        "type": "keyword"
      },
      "mime_type": {
        "type": "keyword"
      },
      "file_size": {
        "type": "long"
      },
      "width": {
        "type": "integer"
      },
      "height": {
        "type": "integer"
      },
      "duration_seconds": {
        "type": "integer"
      },
      "creator": {
        "type": "text",
        "analyzer": "media_text_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "credit": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "source": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "copyright_status": {
        "type": "keyword"
      },
      "license": {
        "type": "keyword"
      },
      "rights_statement": {
        "type": "text"
      },
      "folder": {
        "type": "keyword"
      },
      "structured_tags": {
        "type": "nested",
        "properties": {
          "key": {
            "type": "keyword"
          },
          "value": {
            "type": "keyword"
          },
          "value_text": {
            "type": "text",
            "analyzer": "media_text_analyzer"
          }
        }
      },
      "processing_status": {
        "type": "keyword"
      },
      "ai_processing_status": {
        "type": "keyword"
      },
      "is_published": {
        "type": "boolean"
      },
      "published_at": {
        "type": "date"
      },
      "date_created": {
        "type": "date"
      },
      "created_at": {
        "type": "date"
      },
      "updated_at": {
        "type": "date"
      },
      "technical_metadata": {
        "type": "object",
        "enabled": true,
        "properties": {
          "camera_make": {
            "type": "keyword"
          },
          "camera_model": {
            "type": "keyword"
          },
          "iso": {
            "type": "integer"
          },
          "aperture": {
            "type": "keyword"
          },
          "focal_length": {
            "type": "keyword"
          },
          "orientation": {
            "type": "keyword"
          }
        }
      },
      "iptc_metadata": {
        "type": "object",
        "enabled": true,
        "properties": {
          "headline": {
            "type": "text",
            "analyzer": "media_text_analyzer"
          },
          "caption": {
            "type": "text",
            "analyzer": "media_text_analyzer"
          },

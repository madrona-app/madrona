            "type": "keyword"
          },
          "copyright_notice": {
            "type": "text"
          }
        }
      },
      "dublin_core": {
        "type": "object",
        "enabled": true,
        "properties": {
          "dc_title": {
            "type": "text",
            "analyzer": "media_text_analyzer"
          },
          "dc_creator": {
            "type": "keyword"
          },
          "dc_subject": {
            "type": "keyword"
          },
          "dc_description": {
            "type": "text",
            "analyzer": "media_text_analyzer"
          },
          "dc_rights": {
            "type": "text"
          },
          "dc_type": {
            "type": "keyword"
          },
          "dc_format": {
            "type": "keyword"
          }
        }
      },
      "has_derivatives": {
        "type": "boolean"
      },
      "derivative_count": {
        "type": "integer"
      },
      "indexed_at": {
        "type": "date"
      },
      "linked_objects": {
        "type": "nested",
        "properties": {
          "object_id": {
            "type": "keyword"
          },
          "object_number": {
            "type": "text",
            "analyzer": "media_text_analyzer",
            "fields": {
              "keyword": {
                "type": "keyword"
              }
            }
          },
          "title": {
            "type": "text",
            "analyzer": "media_text_analyzer"
          },
          "creator": {
            "type": "text",
            "analyzer": "media_text_analyzer"
          },
          "creation_date": {
            "type": "text"
          },
          "copyright_status": {
            "type": "keyword"
          },
          "credit_line": {
            "type": "text",
            "analyzer": "media_text_analyzer"
          }
        }
      },
      "linked_object_numbers": {
        "type": "text",
        "analyzer": "media_text_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "linked_object_titles": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "linked_object_creators": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "linked_object_types": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "linked_object_media": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "inherited_metadata": {
        "type": "object",
        "enabled": true,
        "properties": {
          "linked_objects": {
            "type": "nested",
            "properties": {
              "object": {
                "type": "object",
                "properties": {
                  "object_id": {"type": "keyword"},
                  "object_number": {"type": "keyword"},
                  "primary_title": {"type": "text", "analyzer": "media_text_analyzer"},
                  "object_type": {"type": "keyword"},
                  "brief_description": {"type": "text", "analyzer": "media_text_analyzer"}
                }
              },
              "creators": {

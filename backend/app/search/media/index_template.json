                  "viaf_id": {"type": "keyword"},
                  "wikidata_id": {"type": "keyword"}
                }
              },
              "dates": {
                "type": "object",
                "properties": {
                  "display": {"type": "text"},
                  "earliest": {"type": "date"},
                  "latest": {"type": "date"},
                  "creation_place": {"type": "text", "analyzer": "media_text_analyzer"}
                }
              },
              "subjects": {
                "type": "object",
                "properties": {
                  "terms": {"type": "keyword"},
                  "style_period": {"type": "keyword"}
                }
              },
              "rights": {
                "type": "object",
                "properties": {
                  "copyright_status": {"type": "keyword"},
                  "credit_line": {"type": "text", "analyzer": "media_text_analyzer"}
                }
              },
              "repository": {
                "type": "object",
                "properties": {
                  "name": {"type": "keyword"}
                }
              }
            }
          },
          "updated_at": {"type": "date"}
        }
      },
      "inherited_metadata_updated_at": {
        "type": "date"
      },
      "inherited_subjects": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "inherited_materials": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "inherited_techniques": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "inherited_depicted_places": {
        "type": "text",
        "analyzer": "media_text_analyzer"
      },
      "ai_tags": {
        "type": "text",

# Madrona Backend Environment Configuration
#
# For running the backend DIRECTLY on your machine (dev-servers.sh), not in
# Docker. Compose reads only the .env at the repository root and never this
# file — see .env.example there for the container setup.
#
# Hosts below are localhost; the root file uses compose service names.

# Application
APP_ENV=development
# Fine as-is for local development. In production the app refuses to start
# with a placeholder value; generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production

# Database — TWO-ROLE SPLIT (mirrors staging; keeps local RLS-faithful)
#   DATABASE_URL        -> madrona_app  (NOBYPASSRLS) — app runtime; RLS ENFORCED.
#   ALEMBIC_DATABASE_URL-> madrona      (owner/BYPASSRLS) — migrations + admin_db_session.
# Both roles + grants are provisioned by docker/postgres/init-db.sh on first
# `docker compose up` (DB_APP_USERNAME/DB_APP_PASSWORD). Do NOT point the app at
# the owner role — that bypasses RLS and hides cross-org bugs that bite on staging.
DATABASE_URL=postgresql+psycopg://madrona_app:madrona_app_test@localhost:5432/madrona
ALEMBIC_DATABASE_URL=postgresql+psycopg://madrona:madrona@localhost:5432/madrona

# Origin used to build links in transactional email. dev-servers.sh runs Vite
# on 5174.
APP_BASE_URL=http://localhost:5174

# Logging
LOG_LEVEL=INFO

# Google OAuth (Application-wide OAuth client credentials)
# These are for the OAuth flow itself, NOT connector-specific credentials
# Connector instances store their own service account keys in connector_instances.config
# To set up: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5174/auth/google/callback

# AI Services for entity classification and transformer generation
# Claude API (Anthropic) - Highest quality, requires API key
ANTHROPIC_API_KEY=

# Ollama (Local) - Privacy-focused, no API key needed
# Install: https://ollama.ai/ or run via Docker
# Models: llama2:7b (classification), codellama:13b (transformers)
OLLAMA_BASE_URL=http://localhost:11434

# AI Provider preference: claude, ollama, or auto (try Claude first, fallback to Ollama)
AI_PROVIDER_PREFERENCE=auto

# --- Embeddings (semantic search + Guide RAG) ---
# Provider: "voyage" = Voyage AI hosted API (use in staging/prod); "ollama" =
# local Ollama (dev only, unreachable in deployed envs).
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
SEMANTIC_SEARCH_ENABLED=true
# Must match the reference_chunks.embedding_vec pgvector column.
# voyage-3.5 supports 256/512/1024/2048; 1024 is the project default.
SEMANTIC_SEARCH_DIMENSIONS=1024

# AWS
AWS_REGION=us-west-2

# Background task processing (Celery + Redis)
# For Docker: redis://:your-password@redis:6379/0
REDIS_URL=redis://localhost:6379/0

# OpenSearch (full-text search; falls back to database search when disabled)
# Comma-separated host:port. For Docker: opensearch:9200
OPENSEARCH_HOSTS=localhost:9200
OPENSEARCH_ENABLED=true

# AWS Cognito (optional — for SSO/federated auth)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Worker (legacy - can be removed after Celery migration)
WORKER_POLL_INTERVAL=5
WORKER_MAX_RETRIES=5

# =============================================================================
# CANONICAL VALIDATION
# =============================================================================
# Controls how non-canonical (legacy) payloads are handled during ingestion.
#
# Modes:
#   warn  - Log validation errors but store anyway (default, production-safe)
#   error - Reject non-canonical payloads (use in CI/staging)
#
# Recommended settings by environment:
#   Production: warn (default) - prevents disruption, legacy payloads stored
#   Staging:    error         - catches issues before production
#   CI:         error         - fails tests if connectors produce bad output
#
# To flip production to strict mode, set this explicitly in production env.
#
CANONICAL_VALIDATION_MODE=warn

# =============================================================================
# Guide
# =============================================================================
# Origin the visitor-facing Guide is served from, for CORS. Only needed if you
# serve it from a different host than the main app.
GUIDE_APP_URL=http://localhost:5175


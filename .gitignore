# Key material — never commit these
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Terraform / infrastructure state. State and plan files hold provider
# credentials and secret values in plaintext; keep state in a remote backend.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
*.tfplan
.terraform/


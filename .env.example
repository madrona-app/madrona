# Madrona Environment Configuration
#
# Copy this file to .env AT THE REPOSITORY ROOT — that is the only path
# docker compose reads. (backend/.env is for running the backend directly,
# outside Docker; compose does not read it.)
#
#     cp .env.example .env
#
# Then replace SECRET_KEY below. The app refuses to start in production
# while it still holds the shipped placeholder.

# Application
APP_ENV=production

# REQUIRED — generate your own, this value will not boot:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-key

# Database — two roles, on purpose.
#
# The app connects as madrona_app, which is NOBYPASSRLS, so row-level
# security is enforced and one organization cannot read another's rows.
# Migrations and admin tasks connect as the owner, which is BYPASSRLS.
# Never point DATABASE_URL at the owner: it silently disables tenant
# isolation. See docker/postgres/init-db.sh for how the roles are created.
DATABASE_URL=postgresql+psycopg://madrona_app:madrona_app_test@postgres:5432/madrona
ALEMBIC_DATABASE_URL=postgresql+psycopg://madrona:madrona@postgres:5432/madrona

# PostgreSQL (for docker-compose)
POSTGRES_USER=madrona
POSTGRES_PASSWORD=madrona
POSTGRES_DB=madrona
DB_APP_USERNAME=madrona_app
DB_APP_PASSWORD=madrona_app_test

# Redis
REDIS_PASSWORD=change-this-to-a-random-password

# Public origin of this deployment. Used to build the links in verification,
# password-reset and MFA-recovery emails, so it must be the URL a recipient
# can actually open — not localhost, once you are past trying it out.
APP_BASE_URL=http://localhost

# Security (RFC 9116 security.txt)
SECURITY_CONTACT=mailto:security@yourdomain.com

# Smithsonian API (for source connector)
SMITHSONIAN_API_KEY=

# Worker
#
# How often the pipeline worker polls the jobs table, in seconds. Turn it up to
# reduce idle database load, down for lower latency on queued runs.
#
# WORKER_POLL_INTERVAL and WORKER_MAX_RETRIES used to be here. Neither was read
# by any code — the poll interval was a literal at the call site and the retry
# policy is a fixed exponential backoff — so setting them changed nothing and
# said nothing. They are gone rather than quietly kept.
WORKER_POLL_INTERVAL_SECONDS=10

# Logging
LOG_LEVEL=INFO

# Media CDN (optional - for WebGL texture loading and better performance)
# Set to CloudFront distribution URL, e.g., https://d1234567890.cloudfront.net
# If not set, S3 presigned URLs will be used (may have CORS issues with WebGL)
MEDIA_CDN_URL=

# AWS Configuration
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=  # Optional if using IAM roles or AWS CLI credentials
# AWS_SECRET_ACCESS_KEY=

# Video Transcoding (AWS MediaConvert)
# Set to the ARN of the MediaConvert IAM role for video transcoding
# If not set, videos will be uploaded but not transcoded
# Get this from: terraform output mediaconvert_role_arn
MEDIACONVERT_ROLE_ARN=

# --- Self-hosting (docker compose defaults; see the README) ---

# Auth: auto = cognito when COGNITO_USER_POOL_ID is set, local otherwise.
# Local auth verifies passwords against the users table; MFA endpoints 501.
AUTH_PROVIDER=auto

# Object storage. The bundled service is SeaweedFS on port 8333. Point this at
# any S3-compatible endpoint, or at AWS S3 itself.
S3_ENDPOINT_URL=http://seaweedfs:8333
# Presigned media URLs are opened by the browser, outside the container
# network — they must be signed against a host the browser can reach.
# This is the app's own public URL, NOT the object store's port: the frontend
# proxies object storage same-origin. A direct http://host:8333 URL is cross-origin
# plain HTTP and is blocked by the page's img-src CSP, which silently breaks
# every thumbnail. Set it to wherever the app is served from.
S3_PUBLIC_ENDPOINT_URL=http://localhost
S3_MEDIA_BUCKET=madrona-media
S3_PLATFORM_BUCKET=madrona-platform
AWS_ACCESS_KEY_ID=madrona-s3
AWS_SECRET_ACCESS_KEY=madrona-s3-changeme

# Email: smtp for self-hosting (ses for AWS). EMAIL_ENABLED=false logs
# activation/invite links to the backend log instead of sending.
EMAIL_PROVIDER=smtp
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Search (compose runs a single-node OpenSearch)
OPENSEARCH_HOSTS=opensearch:9200
OPENSEARCH_ENABLED=true

# AI auto-tagging uses AWS Rekognition — the only provider. Leave off
# unless you have AWS credentials, or every uploaded image logs a failed
# DetectLabels call.
AI_TAGGING_ENABLED=false

# Video transcoding stays off unless you wire AWS MediaConvert.
# MEDIACONVERT_ROLE_ARN=

# Host ports. Only the left-hand side of each compose port mapping; the
# container-side ports never change. Override any that collide with something
# already running on your machine — a local Postgres on 5432 or a Homebrew
# Redis on 6379 are the common ones. Everything inside the stack talks over the
# compose network and is unaffected.
#HTTP_HOST_PORT=80
#BACKEND_HOST_PORT=8000
#POSTGRES_HOST_PORT=5432
#REDIS_HOST_PORT=6379
#S3_HOST_PORT=8333
#OPENSEARCH_HOST_PORT=9200
#OPENSEARCH_DASHBOARDS_HOST_PORT=5601
#OLLAMA_HOST_PORT=11434
#TUSD_HOST_PORT=1080
#UNOSERVER_HOST_PORT=2003

# ---------------------------------------------------------------------------
# Frontend build-time configuration
#
# Everything under this heading is compiled INTO the frontend bundle. Vite
# inlines VITE_* names when it builds, so compose passes each one to the
# frontend image as a build arg and changing any of them needs
#
#     docker compose build frontend
#
# not a restart. Nothing here is read at runtime, and a name that is not listed
# in the frontend service's build.args is wired to nothing — silently.
#
# For `pnpm dev` and a local `pnpm build`, Vite reads frontend/.env instead of
# this file: its env directory is the frontend project, not the repository root.
# See frontend/.env.example.
#
# Every value here reaches the browser. Treat none of it as private.
# ---------------------------------------------------------------------------

# Where the frontend calls the API. The default, /api, is same-origin and is
# proxied by the frontend's nginx to the backend — correct for docker-compose
# and for any single-origin deployment. Set it only when the API is served from
# a different origin, in which case the backend's CORS_ORIGINS must allow the
# frontend's origin too.
#VITE_API_BASE_URL=/api

# Email identity (optional). Unset, Madrona sends as accounts@ and
# notifications@ the host of APP_BASE_URL, and prints support@ that host in
# email footers — i.e. as this deployment, with no further configuration.
#SES_ACCOUNTS_FROM=
#SES_NOTIFICATIONS_FROM=
#SUPPORT_EMAIL=

# Error reporting (optional, off unless a DSN is set). The DSN is a write-only
# ingest address and ships in the bundle by design. VITE_SENTRY_ALLOW_DEV=true
# is needed for a development build to report at all — without it a local build
# stays silent rather than filing issues against the deployed app's project.
#VITE_SENTRY_DSN=
#VITE_SENTRY_ENVIRONMENT=production
#VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
#VITE_SENTRY_ALLOW_DEV=

# Resumable uploads (optional). Files over 10 MB go through tus when this is
# set, and through the ordinary upload path when it is not. Setting it is not
# sufficient on its own: the tusd service is behind the `tus` compose profile,
# so it needs `docker compose --profile tus up`, and the frontend's nginx has no
# location proxying it — a cross-origin plain-HTTP endpoint is blocked by the
# page's connect-src CSP. Add a same-origin proxy entry first, then point this
# at that path.
#VITE_TUS_ENDPOINT=

# Visitor guide embed (optional). Where the embeddable widget script is
# hosted; it is not served by this app. Unset, the widget settings page offers
# no embed code rather than guessing a host.
#VITE_GUIDE_WIDGET_URL=

# Basemap tiles (optional)
#
# Left unset, maps use OpenFreeMap (tiles.openfreemap.org): OpenStreetMap data
# served as vector tiles with no account, no key and no usage limits,
# commercial use allowed. Light, dark and standard themes all work as shipped,
# so there is nothing to configure here for a normal install.
#
# Point any theme at a basemap you control — a self-hosted OpenFreeMap
# instance, a Protomaps PMTiles file, MapTiler, anything that serves a MapLibre
# style document. Set these if the app must not reach a third party at all.
#VITE_MAP_STYLE_LIGHT=
#VITE_MAP_STYLE_DARK=
#VITE_MAP_STYLE_STANDARD=
#
# CARTO's Positron / Dark Matter, for an institution that already holds a CARTO
# key; it takes over the light and dark themes. Without a key CARTO stamps
# "API KEY REQUIRED" across every tile, which is why it is not the default.
VITE_CARTO_API_KEY=

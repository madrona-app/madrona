# Frontend configuration.
#
# Vite reads env files from this directory, not the repository root, so this is
# the file that matters for `pnpm dev` and a local `pnpm build`. A
# docker-compose deployment sets the same names in the root .env, which compose
# passes to the frontend image as build args.
#
# All of it is inlined into the bundle at build time and reaches the browser.
# Nothing here is private.

# Where the frontend calls the API. /api is same-origin and is proxied to the
# backend; change it only if the API lives on another origin.
VITE_API_BASE_URL=/api

# Error reporting (optional). A development build will not report unless
# VITE_SENTRY_ALLOW_DEV is set — otherwise local runs file issues against the
# deployed app's Sentry project, which is how that project filled up once.
#VITE_SENTRY_DSN=
#VITE_SENTRY_ENVIRONMENT=development
#VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
#VITE_SENTRY_ALLOW_DEV=

# Resumable uploads (optional). Files over 10 MB use tus when this is set. It
# must be same-origin or CSP-allowed; see the note in the root .env.example.
#VITE_TUS_ENDPOINT=

# Visitor guide embed (optional). Where the embeddable widget script is
# hosted; it is not served by this app. Unset, the widget settings page offers
# no embed code rather than guessing a host.
#VITE_GUIDE_WIDGET_URL=

# Basemap tiles (optional).
#
# Unset, maps use OpenFreeMap — no account, no key, no usage limits, and light,
# dark and standard themes all work. Override a theme to point at a basemap you
# control; set VITE_CARTO_API_KEY only if you already hold a CARTO key.
#VITE_MAP_STYLE_LIGHT=
#VITE_MAP_STYLE_DARK=
#VITE_MAP_STYLE_STANDARD=
#VITE_CARTO_API_KEY=

{
  "name": "madrona-frontend",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm run check:nav-catalog",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 3340",
    "preview": "vite preview",
    "serve:e2e": "node scripts/serve-e2e.mjs dist",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:nav-catalog": "vitest run src/test/lib/navigationCatalog.test.ts -u",
    "check:nav-catalog": "vitest run src/test/lib/navigationCatalog.test.ts",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:login": "./scripts/test-e2e.sh",
    "test:e2e:login:ui": "./scripts/test-e2e.sh --ui",
    "test:smoke": "playwright test smoke.spec.ts --project=chromium",
    "test:smoke:report": "playwright test smoke.spec.ts --project=chromium -g 'full smoke report' --no-skip",
    "test:buttons": "playwright test all-buttons.spec.ts workspace-buttons.spec.ts interactive-elements.spec.ts --project=chromium",
    "test:buttons:list": "playwright test all-buttons.spec.ts --project=chromium",
    "test:buttons:workspace": "playwright test workspace-buttons.spec.ts --project=chromium",
    "test:buttons:interactive": "playwright test interactive-elements.spec.ts --project=chromium",
    "test:render": "playwright test render-stability.spec.ts --project=chromium",
    "test:contracts": "playwright test api-contract.spec.ts --project=chromium",
    "test:contracts:record": "RECORD_API=1 playwright test api-contract.spec.ts --project=chromium",
    "test:all": "playwright test specs/pages/ --project=chromium",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/react": "^10.76.0",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "axios": "^1.20.0",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.11.2",
    "openseadragon": "^5.0.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^5.5.7",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.5.0",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "wavesurfer.js": "^7.12.12",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "flatted@<3.4.2": "3.4.2",
      "dompurify@<3.4.16": "3.4.16",
      "socket.io-parser@<4.2.7": "4.2.7",
      "lodash-es@<=4.17.23": "4.18.0",
      "follow-redirects@<=1.15.11": "1.16.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "protocol-buffers-schema@<3.6.1": "3.6.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/openseadragon": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
